  "findings": [
    {
      "rule": "KD212",
      "title": "Probe connects over TCP to a UDP port",
      "severity": "critical",
      "object": {
        "kind": "Deployment",
        "namespace": "kd-probe-udp-port",
        "name": "log-receiver"
      },
      "cause": "container receiver's readiness probe (tcpSocket) checks port 5514 (named syslog), which the container declares for UDP only: probes connect over TCP, where nothing listens on that port, so the probe fails, so the container never becomes ready and gets no traffic; Deployment log-receiver has 0 of 1 replicas ready",
      "evidence": [
        {
          "object": {
            "kind": "Pod",
            "namespace": "kd-probe-udp-port",
            "name": "log-receiver-664d876767-hvhnl"
          },
          "what": "event Unhealthy (64 times)",
          "detail": "Readiness probe failed: dial tcp 10.244.0.123:5514: connect: connection refused",
          "command": "kubectl get events -n kd-probe-udp-port --field-selector involvedObject.kind=Pod,involvedObject.name=log-receiver-664d876767-hvhnl"
        },
        {
          "object": {
            "kind": "Pod",
            "namespace": "kd-probe-udp-port",
            "name": "log-receiver-664d876767-hvhnl"
          },
          "what": "container receiver's readiness probe",
          "command": "kubectl get pod log-receiver-664d876767-hvhnl -n kd-probe-udp-port -o jsonpath='{.spec.containers[?(@.name==\"receiver\")].readinessProbe}'"
        },
        {
          "object": {
            "kind": "Pod",
            "namespace": "kd-probe-udp-port",
            "name": "log-receiver-664d876767-hvhnl"
          },
          "what": "container receiver's ports",
          "command": "kubectl get pod log-receiver-664d876767-hvhnl -n kd-probe-udp-port -o jsonpath='{.spec.containers[?(@.name==\"receiver\")].ports}'"
        }
      ],
      "fix": "Probe a TCP port the app serves (a health or metrics endpoint), or use an exec probe that sends a real query (a DNS server: nslookup or dig against 127.0.0.1); a probe cannot check UDP port 5514.",
      "affects": [
        {
          "kind": "Pod",
          "namespace": "kd-probe-udp-port",
          "name": "log-receiver-664d876767-hvhnl"
        }
      ]
    }
