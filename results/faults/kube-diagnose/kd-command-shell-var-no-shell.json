  "findings": [
    {
      "rule": "KD213",
      "title": "Command uses a shell variable with no shell",
      "severity": "critical",
      "object": {
        "kind": "Deployment",
        "namespace": "kd-command-shell-var-no-shell",
        "name": "worker"
      },
      "cause": "container worker's command uses $SLEEP_SECONDS, the shell's syntax, but the command runs without a shell, so nothing expands it: the process receives the text $SLEEP_SECONDS and fails on it (Kubernetes expands only $(SLEEP_SECONDS)); its log says: \"sleep: invalid number '$SLEEP_SECONDS'\"; Deployment worker has 0 of 1 replicas ready",
      "evidence": [
        {
          "object": {
            "kind": "Pod",
            "namespace": "kd-command-shell-var-no-shell",
            "name": "worker-64998f8757-vj2zl"
          },
          "what": "container worker exited with code 1 (Error), restarted 4 times",
          "command": "kubectl get pod worker-64998f8757-vj2zl -n kd-command-shell-var-no-shell -o jsonpath='{.status.containerStatuses[?(@.name==\"worker\")].lastState.terminated}'"
        },
        {
          "object": {
            "kind": "Pod",
            "namespace": "kd-command-shell-var-no-shell",
            "name": "worker-64998f8757-vj2zl"
          },
          "what": "last lines of container worker's log (run that exited)",
          "detail": "sleep: invalid number '$SLEEP_SECONDS'",
          "command": "kubectl logs worker-64998f8757-vj2zl -n kd-command-shell-var-no-shell -c worker --tail=20 --previous"
        },
        {
          "object": {
            "kind": "Pod",
            "namespace": "kd-command-shell-var-no-shell",
            "name": "worker-64998f8757-vj2zl"
          },
          "what": "container worker's command has $SLEEP_SECONDS and runs no shell",
          "command": "kubectl get pod worker-64998f8757-vj2zl -n kd-command-shell-var-no-shell -o jsonpath='{.spec.containers[?(@.name==\"worker\")].command}'"
        }
      ],
      "fix": "Write it as $(SLEEP_SECONDS), which Kubernetes expands from the container's env, or run the command through a shell: [\"sh\", \"-c\", \"...\"].",
      "affects": [
        {
          "kind": "Pod",
          "namespace": "kd-command-shell-var-no-shell",
          "name": "worker-64998f8757-vj2zl"
        }
      ]
    }
