          },
          "what": "the budget has selector app=frontend and expects 0 pods",
          "command": "kubectl get pdb web -n kd-pdb-selects-nothing -o jsonpath='{.spec.selector}{\"\\n\"}{.status.expectedPods}'"
        },
        {
          "object": {
