            "namespace": "kd-pdb-selects-nothing",
            "name": "*"
          },
          "what": "pod labels in the namespace",
          "command": "kubectl get pods -n kd-pdb-selects-nothing --show-labels"
        }
      ],
      "fix": "Change the budget's selector to match the pods it should protect (app=web)."
