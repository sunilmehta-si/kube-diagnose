          "detail": "Readiness probe errored and resulted in unknown state: port \"health\" not found",
          "command": "kubectl get events -n kd-probe-port-name-missing --field-selector involvedObject.kind=Pod,involvedObject.name=api-c688bf54b-csb5r"
        },
        {
          "object": {
            "kind": "Pod",
            "namespace": "kd-probe-port-name-missing",
            "name": "api-c688bf54b-csb5r"
          },
          "what": "container api's readiness probe",
          "command": "kubectl get pod api-c688bf54b-csb5r -n kd-probe-port-name-missing -o jsonpath='{.spec.containers[?(@.name==\"api\")].readinessProbe}'"
        },
        {
          "object": {
            "kind": "Pod",
            "namespace": "kd-probe-port-name-missing",
            "name": "api-c688bf54b-csb5r"
          },
          "what": "container api declares ports http (8080)",
