# Everything the fault suite downloads, pinned by version and checksum. Each was at least 14 days old when pinned.
# hack/faults.sh reads this file; a variable already set in the environment wins.
KIND_VERSION=v0.33.0
KIND_SHA256_LINUX_AMD64=aee6151561422756b764a4ae28e7f44cda5af5a9eead3cc9985112b1de8d8e0d
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5
K8SGPT_VERSION=v0.4.41
K8SGPT_SHA256_LINUX_AMD64=e56b5cbe826dbf1e314075453105426acca2ad4410e64073d665c697c97208ed
HOLMES_VERSION=0.46.0
HOLMES_SHA256_LINUX_AMD64=b139ffac5fe25e7db14fdc3b29bcf43f745f23b6e9eb2ae7712079552609f45f
# The scenarios' working image (busybox 1.37.0's multi-platform index) and its arm64-only manifest, which the
# exec-format-error scenario runs on amd64 nodes. The manifests carry these digests; a test checks they match.
BUSYBOX_IMAGE=docker.io/library/busybox:1.37.0@sha256:a7dbc319b1438115a207e11930dc4bb3e643dcb3ec0bdd694bb36cd8fad289ec
BUSYBOX_ARM64_IMAGE=docker.io/library/busybox@sha256:d82c2ab94640ded77cf76514ce6a84870761105058a4a9e51b05a8a79be97a6c
# An index with only a linux/arm64 build (and its attestation), for the image-wrong-platform scenario: an amd64
# node finds no manifest for its platform and cannot pull it.
BUSYBOX_ARM64_ONLY_IMAGE=docker.io/arm64v8/busybox:1.37.0@sha256:b3b1fa492bae35fe28c5ff48dddb493b9d8a429b3d8b0a92b2e3f0774968acd7
